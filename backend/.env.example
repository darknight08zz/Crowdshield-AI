# CrowdShield Backend Configuration Template
# Copy this file to .env and configure environment-specific settings.

# System Environment & Server Settings
PROJECT_NAME="CrowdShield API"
VERSION="1.0.0"
ENV="development" # Options: development, test, production
DEBUG="false"
HOST="0.0.0.0"
PORT="8000"
LOG_LEVEL="INFO"
LOG_FILE_PATH="logs/application.log"
REALTIME_ENABLED="true"

# Security & CORS Origins (Comma-separated)
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:19006"

# Supabase & Auth Credentials
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Relational Database Connection (PostgreSQL / Supabase Connection URI)
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_ID.supabase.co:5432/postgres"

# Database Connection Pool Tuning
DATABASE_POOL_SIZE="10"
DATABASE_MAX_OVERFLOW="20"
DATABASE_POOL_TIMEOUT="30"
DATABASE_POOL_RECYCLE="1800"

# Computer Vision & Realtime AI Inference Settings
YOLO_DEVICE="auto" # "auto", "cpu", "cuda"
YOLO_IMAGE_SIZE="640"
YOLO_CONFIDENCE="0.35"
CV_TRACKER_TYPE="bytetrack"
FRAME_SAMPLE_RATE="5"

# Phase 6F Asynchronous Persistence Queue Settings
REALTIME_PERSISTENCE_QUEUE_MAXSIZE="100"
REALTIME_PERSISTENCE_WORKERS="2"
REALTIME_FRAME_BUFFER_SIZE="1"
REALTIME_MAX_FRAME_AGE="2.0"
