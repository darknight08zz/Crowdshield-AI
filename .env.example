# CrowdShield Global Environment Variables

# Backend Service Configuration
PROJECT_NAME="CrowdShield API"
VERSION="1.0.0"
ENV="development"
HOST="0.0.0.0"
PORT="8000"

# CORS Configuration
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://localhost:8000,http://127.0.0.1:3000,http://localhost:19006"

# Supabase Credentials (Get from Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY"
SUPABASE_JWT_SECRET="YOUR_SUPABASE_JWT_SECRET"

# Database Connection String (Use SQLite for local dev or PostgreSQL for production)
DATABASE_URL="sqlite:///./crowdshield.db"

# Next.js Web Dashboard Environment Variables
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"
NEXT_PUBLIC_API_BASE_URL="http://localhost:8000/api/v1"

# Mobile App Environment Variables
EXPO_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_ID.supabase.co"
EXPO_PUBLIC_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Firebase Cloud Messaging Credentials Path
FIREBASE_CREDENTIALS_PATH=""
